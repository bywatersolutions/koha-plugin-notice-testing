{
    "/validation": {
        "post": {
            "x-mojo-to": "Com::ByWaterSolutions::NoticeEditor::Controller#validate",
            "operationId": "noticeEditorValidateTemplates",
            "tags": [
                "notice_editor"
            ],
            "summary": "Check notice templates for problems, without saving them",
            "description": "Checks the templates of a notice, e.g. for Template Toolkit syntax errors,\nas the notice editor does before saving them. Templates without a title\nor a content are not checked.\n",
            "parameters": [
                {
                    "name": "body",
                    "in": "body",
                    "description": "The notice and its templates",
                    "required": true,
                    "schema": {
                        "type": "object",
                        "properties": {
                            "module": {
                                "type": "string",
                                "description": "Module of the notice (e.g. `circulation`)"
                            },
                            "code": {
                                "type": "string",
                                "description": "Code of the notice (e.g. `ODUE`)"
                            },
                            "templates": {
                                "type": "array",
                                "description": "Templates of the notice, one for each transport type and language",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "message_transport_type": {
                                            "type": "string",
                                            "description": "Transport type of the template (e.g. `email`)"
                                        },
                                        "lang": {
                                            "type": "string",
                                            "description": "Language of the template (e.g. `default`)"
                                        },
                                        "title": {
                                            "type": "string",
                                            "description": "Subject of the template"
                                        },
                                        "content": {
                                            "type": "string",
                                            "description": "Body of the template"
                                        }
                                    },
                                    "required": [
                                        "message_transport_type",
                                        "lang"
                                    ],
                                    "additionalProperties": false
                                }
                            }
                        },
                        "required": [
                            "module",
                            "templates"
                        ],
                        "additionalProperties": false
                    }
                }
            ],
            "consumes": [
                "application/json"
            ],
            "produces": [
                "application/json"
            ],
            "responses": {
                "200": {
                    "description": "The problems found in each template that was checked",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "templates": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "message_transport_type": {
                                            "type": "string",
                                            "description": "Transport type of the template"
                                        },
                                        "lang": {
                                            "type": "string",
                                            "description": "Language of the template"
                                        },
                                        "problems": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "description": "A problem found in a notice template",
                                                "properties": {
                                                    "type": {
                                                        "type": "string",
                                                        "description": "The kind of problem:\n\n* `tt_syntax`: the Template Toolkit markup cannot be parsed\n* `unclosed_tag`: a `[%` has no matching `%]`\n* `lowercase_directive`: a Template Toolkit directive not written in capitals\n* `tt_error`: processing the template without data fails\n* `missing_repeatable_content`: the notice receives a list of records,\n  but the template has nothing to list them with\n* `unknown_variable`: a variable the notice does not receive\n* `unknown_method`: a field or method that does not exist on an object\n* `unknown_key`: a key that does not exist in a hash (only checked when\n  the hash's keys are listed, e.g. `branch` on SR_SLIP)\n* `missing_plugin`: a plugin used without being loaded\n* `unknown_block`: a block processed but not defined\n"
                                                    },
                                                    "severity": {
                                                        "type": "string",
                                                        "enum": [
                                                            "error",
                                                            "warning"
                                                        ],
                                                        "description": "`error` if the notice cannot be generated, `warning` if it can but will not show what is expected"
                                                    },
                                                    "field": {
                                                        "type": "string",
                                                        "enum": [
                                                            "title",
                                                            "content"
                                                        ],
                                                        "description": "The part of the template the problem is in"
                                                    },
                                                    "lines": {
                                                        "type": "array",
                                                        "items": {
                                                            "type": "integer"
                                                        },
                                                        "description": "The lines of the field the problem is on"
                                                    },
                                                    "error": {
                                                        "type": "string",
                                                        "description": "The Template Toolkit error message"
                                                    },
                                                    "directive": {
                                                        "type": "string",
                                                        "description": "The Template Toolkit directive, in capitals"
                                                    },
                                                    "used": {
                                                        "type": "string",
                                                        "description": "The directive as written in the template"
                                                    },
                                                    "loop": {
                                                        "type": "string",
                                                        "description": "The Template Toolkit variable holding the records to list"
                                                    },
                                                    "tokens": {
                                                        "type": "array",
                                                        "items": {
                                                            "type": "string"
                                                        },
                                                        "description": "The bespoke placeholders listing the records"
                                                    },
                                                    "tags": {
                                                        "type": "array",
                                                        "items": {
                                                            "type": "string"
                                                        },
                                                        "description": "The bespoke enclosing tags whose content is repeated for each record"
                                                    },
                                                    "variable": {
                                                        "type": "string",
                                                        "description": "The variable, or the path up to the field or method, that is not available"
                                                    },
                                                    "class": {
                                                        "type": "string",
                                                        "description": "The class that has no such field or method"
                                                    },
                                                    "suggestion": {
                                                        "type": [
                                                            "string",
                                                            "null"
                                                        ],
                                                        "description": "A variable the notice receives holding the same kind of object"
                                                    },
                                                    "available": {
                                                        "type": "array",
                                                        "items": {
                                                            "type": "string"
                                                        },
                                                        "description": "The variables the notice receives"
                                                    },
                                                    "keys": {
                                                        "type": "array",
                                                        "items": {
                                                            "type": "string"
                                                        },
                                                        "description": "The keys of the hash"
                                                    },
                                                    "plugin": {
                                                        "type": "string",
                                                        "description": "The plugin used without being loaded"
                                                    },
                                                    "block": {
                                                        "type": "string",
                                                        "description": "The block processed but not defined"
                                                    }
                                                },
                                                "additionalProperties": false,
                                                "required": [
                                                    "type",
                                                    "severity"
                                                ]
                                            }
                                        }
                                    },
                                    "required": [
                                        "message_transport_type",
                                        "lang",
                                        "problems"
                                    ],
                                    "additionalProperties": false
                                }
                            }
                        },
                        "required": [
                            "templates"
                        ],
                        "additionalProperties": false
                    }
                },
                "400": {
                    "description": "Bad request",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "error": {
                                "type": "string",
                                "description": "An explanation for the error"
                            },
                            "error_code": {
                                "type": "string",
                                "description": "Code describing the error"
                            }
                        },
                        "additionalProperties": true
                    }
                },
                "401": {
                    "description": "Authentication required",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "error": {
                                "type": "string",
                                "description": "An explanation for the error"
                            },
                            "error_code": {
                                "type": "string",
                                "description": "Code describing the error"
                            }
                        },
                        "additionalProperties": true
                    }
                },
                "403": {
                    "description": "Access forbidden",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "error": {
                                "type": "string",
                                "description": "An explanation for the error"
                            },
                            "error_code": {
                                "type": "string",
                                "description": "Code describing the error"
                            }
                        },
                        "additionalProperties": true
                    }
                },
                "500": {
                    "description": "Internal server error. Possible `error_code` attribute values:\n\n* `internal_server_error`\n",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "error": {
                                "type": "string",
                                "description": "An explanation for the error"
                            },
                            "error_code": {
                                "type": "string",
                                "description": "Code describing the error"
                            }
                        },
                        "additionalProperties": true
                    }
                },
                "503": {
                    "description": "Under maintenance",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "error": {
                                "type": "string",
                                "description": "An explanation for the error"
                            },
                            "error_code": {
                                "type": "string",
                                "description": "Code describing the error"
                            }
                        },
                        "additionalProperties": true
                    }
                }
            },
            "x-koha-authorization": {
                "permissions": {
                    "tools": "edit_notices"
                }
            }
        }
    },
    "/fields": {
        "get": {
            "x-mojo-to": "Com::ByWaterSolutions::NoticeEditor::Controller#fields",
            "operationId": "noticeEditorListFields",
            "tags": [
                "notice_editor"
            ],
            "summary": "List the fields the notice editor offers to insert in a notice",
            "parameters": [
                {
                    "name": "module",
                    "in": "query",
                    "type": "string",
                    "required": true,
                    "description": "Module of the notice"
                },
                {
                    "name": "code",
                    "in": "query",
                    "type": "string",
                    "required": false,
                    "description": "Code of the notice"
                }
            ],
            "produces": [
                "application/json"
            ],
            "responses": {
                "200": {
                    "description": "The fields, the syntaxes the notice can use, and the records it can be previewed with",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "fields": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "text": {
                                            "type": "string",
                                            "description": "Text shown in the list"
                                        },
                                        "syntax": {
                                            "type": "string",
                                            "enum": [
                                                "tt",
                                                "bespoke",
                                                "both"
                                            ],
                                            "description": "Syntaxes the field can be inserted with"
                                        },
                                        "tt": {
                                            "type": "string",
                                            "description": "Template Toolkit text to insert"
                                        },
                                        "value": {
                                            "type": "string",
                                            "description": "Name to insert as <<value>> with the bespoke syntax"
                                        },
                                        "bespoke": {
                                            "type": "string",
                                            "description": "Bespoke text to insert, when it is not <<value>>"
                                        },
                                        "use": {
                                            "type": "string",
                                            "description": "Template Toolkit plugin the field needs loaded"
                                        },
                                        "fallback": {
                                            "type": "boolean",
                                            "description": "Only the bespoke syntax can use the field in the notice"
                                        }
                                    },
                                    "required": [
                                        "text",
                                        "syntax"
                                    ],
                                    "additionalProperties": false
                                }
                            },
                            "insert_syntaxes": {
                                "type": "array",
                                "items": {
                                    "type": "string",
                                    "enum": [
                                        "tt",
                                        "bespoke",
                                        "mixed"
                                    ]
                                }
                            },
                            "only_bespoke": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            },
                            "preview_records": {
                                "type": "array",
                                "items": {
                                    "type": "string",
                                    "enum": [
                                        "patron",
                                        "item",
                                        "basket",
                                        "order",
                                        "vendor",
                                        "hold",
                                        "suggestion",
                                        "illrequest",
                                        "booking",
                                        "article_request",
                                        "recall",
                                        "ticket",
                                        "subscription",
                                        "oai_server"
                                    ]
                                },
                                "description": "Kinds of records the notice can be previewed with, in the order to offer them"
                            },
                            "preview_combines": {
                                "type": "boolean",
                                "description": "Whether the notice is sent once per item and combined, so it can be previewed with several items"
                            }
                        },
                        "required": [
                            "fields",
                            "insert_syntaxes",
                            "only_bespoke",
                            "preview_records",
                            "preview_combines"
                        ],
                        "additionalProperties": false
                    }
                },
                "400": {
                    "description": "Bad request",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "error": {
                                "type": "string",
                                "description": "An explanation for the error"
                            },
                            "error_code": {
                                "type": "string",
                                "description": "Code describing the error"
                            }
                        },
                        "additionalProperties": true
                    }
                },
                "401": {
                    "description": "Authentication required",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "error": {
                                "type": "string",
                                "description": "An explanation for the error"
                            },
                            "error_code": {
                                "type": "string",
                                "description": "Code describing the error"
                            }
                        },
                        "additionalProperties": true
                    }
                },
                "403": {
                    "description": "Access forbidden",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "error": {
                                "type": "string",
                                "description": "An explanation for the error"
                            },
                            "error_code": {
                                "type": "string",
                                "description": "Code describing the error"
                            }
                        },
                        "additionalProperties": true
                    }
                },
                "500": {
                    "description": "Internal server error. Possible `error_code` attribute values:\n\n* `internal_server_error`\n",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "error": {
                                "type": "string",
                                "description": "An explanation for the error"
                            },
                            "error_code": {
                                "type": "string",
                                "description": "Code describing the error"
                            }
                        },
                        "additionalProperties": true
                    }
                },
                "503": {
                    "description": "Under maintenance",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "error": {
                                "type": "string",
                                "description": "An explanation for the error"
                            },
                            "error_code": {
                                "type": "string",
                                "description": "Code describing the error"
                            }
                        },
                        "additionalProperties": true
                    }
                }
            },
            "x-koha-authorization": {
                "permissions": {
                    "tools": "edit_notices"
                }
            }
        }
    },
    "/preview": {
        "post": {
            "x-mojo-to": "Com::ByWaterSolutions::NoticeEditor::Controller#preview",
            "operationId": "noticeEditorPreview",
            "tags": [
                "notice_editor"
            ],
            "summary": "Preview a notice template with the records of a patron",
            "parameters": [
                {
                    "name": "body",
                    "in": "body",
                    "required": true,
                    "description": "The template and the records to preview it with",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "module": {
                                "type": "string",
                                "description": "Module of the notice"
                            },
                            "code": {
                                "type": "string",
                                "description": "Code of the notice"
                            },
                            "message_transport_type": {
                                "type": "string",
                                "description": "Transport type of the template"
                            },
                            "lang": {
                                "type": "string",
                                "description": "Language of the template"
                            },
                            "title": {
                                "type": "string",
                                "description": "Subject of the template"
                            },
                            "content": {
                                "type": "string",
                                "description": "Body of the template"
                            },
                            "is_html": {
                                "type": "boolean",
                                "description": "Whether the template is HTML"
                            },
                            "style": {
                                "type": "string",
                                "description": "CSS of the notice, for print templates"
                            },
                            "records": {
                                "type": "object",
                                "description": "The records to preview the notice with, by kind (e.g. patron, basket): a card number for a patron, a barcode for an item (several, separated by commas, for notices combining items), an id or name for a vendor or an OAI server, an id for the others",
                                "properties": {
                                    "patron": {
                                        "type": "string"
                                    },
                                    "item": {
                                        "type": "string"
                                    },
                                    "basket": {
                                        "type": "string"
                                    },
                                    "order": {
                                        "type": "string"
                                    },
                                    "vendor": {
                                        "type": "string"
                                    },
                                    "hold": {
                                        "type": "string"
                                    },
                                    "suggestion": {
                                        "type": "string"
                                    },
                                    "illrequest": {
                                        "type": "string"
                                    },
                                    "booking": {
                                        "type": "string"
                                    },
                                    "article_request": {
                                        "type": "string"
                                    },
                                    "recall": {
                                        "type": "string"
                                    },
                                    "ticket": {
                                        "type": "string"
                                    },
                                    "subscription": {
                                        "type": "string"
                                    },
                                    "oai_server": {
                                        "type": "string"
                                    }
                                },
                                "additionalProperties": false
                            }
                        },
                        "required": [
                            "module"
                        ],
                        "additionalProperties": false
                    }
                }
            ],
            "consumes": [
                "application/json"
            ],
            "produces": [
                "application/json"
            ],
            "responses": {
                "200": {
                    "description": "The notice, rendered",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "title": {
                                "type": "string",
                                "description": "Subject of the notice"
                            },
                            "html": {
                                "type": "string",
                                "description": "The notice as shown to patrons, as an HTML document"
                            },
                            "messages": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "code": {
                                            "type": "string",
                                            "enum": [
                                                "not_found",
                                                "combined"
                                            ]
                                        },
                                        "value": {
                                            "type": "string"
                                        },
                                        "kind": {
                                            "type": "string",
                                            "enum": [
                                                "patron",
                                                "item",
                                                "basket",
                                                "order",
                                                "vendor",
                                                "hold",
                                                "suggestion",
                                                "illrequest",
                                                "booking",
                                                "article_request",
                                                "recall",
                                                "ticket",
                                                "subscription",
                                                "oai_server"
                                            ],
                                            "description": "Kind of the record not found"
                                        }
                                    },
                                    "required": [
                                        "code"
                                    ],
                                    "additionalProperties": false
                                }
                            },
                            "notes": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "code": {
                                            "type": "string"
                                        },
                                        "variable": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "code"
                                    ],
                                    "additionalProperties": false
                                }
                            },
                            "patron": {
                                "type": [
                                    "object",
                                    "null"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string"
                                    },
                                    "cardnumber": {
                                        "type": [
                                            "string",
                                            "null"
                                        ]
                                    }
                                },
                                "additionalProperties": false
                            }
                        },
                        "required": [
                            "title",
                            "html",
                            "messages",
                            "notes",
                            "patron"
                        ],
                        "additionalProperties": false
                    }
                },
                "400": {
                    "description": "Bad request",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "error": {
                                "type": "string",
                                "description": "An explanation for the error"
                            },
                            "error_code": {
                                "type": "string",
                                "description": "Code describing the error"
                            }
                        },
                        "additionalProperties": true
                    }
                },
                "401": {
                    "description": "Authentication required",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "error": {
                                "type": "string",
                                "description": "An explanation for the error"
                            },
                            "error_code": {
                                "type": "string",
                                "description": "Code describing the error"
                            }
                        },
                        "additionalProperties": true
                    }
                },
                "403": {
                    "description": "Access forbidden",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "error": {
                                "type": "string",
                                "description": "An explanation for the error"
                            },
                            "error_code": {
                                "type": "string",
                                "description": "Code describing the error"
                            }
                        },
                        "additionalProperties": true
                    }
                },
                "500": {
                    "description": "Internal server error. Possible `error_code` attribute values:\n\n* `internal_server_error`\n",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "error": {
                                "type": "string",
                                "description": "An explanation for the error"
                            },
                            "error_code": {
                                "type": "string",
                                "description": "Code describing the error"
                            }
                        },
                        "additionalProperties": true
                    }
                },
                "503": {
                    "description": "Under maintenance",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "error": {
                                "type": "string",
                                "description": "An explanation for the error"
                            },
                            "error_code": {
                                "type": "string",
                                "description": "Code describing the error"
                            }
                        },
                        "additionalProperties": true
                    }
                }
            },
            "x-koha-authorization": {
                "permissions": {
                    "tools": "edit_notices"
                }
            }
        }
    }
}